# --- LLM provider (Groq, free tier) ---
GROQ_API_KEY=""
# Optional 2nd Groq key for the fallback model; if empty the gateway reuses GROQ_API_KEY
GROQ_FALLBACK_API_KEY=""
# Optional key used only by evals
JUDGE_GROQ=""

# --- LiteLLM gateway (self-hosted, replaces Portkey) ---
LITELLM_BASE_URL="http://localhost:4000"
# Any value starting with sk- (the app and the gateway must use the same one)
LITELLM_MASTER_KEY="sk-local-dev-key"

# --- Vector DB (Qdrant Cloud) ---
# Add :443 at the end (default port 6333 is blocked on many networks), e.g. https://<id>.<region>.aws.cloud.qdrant.io:443
QDRANT_CLUSTER_ENDPOINT=""
QDRANT_API_KEY=""

# Reranker relevance cut-off (0..1); below this a chunk counts as irrelevant (default 0.01)
# MIN_RERANK_SCORE=0.01

# --- Conversation persistence (Postgres) ---
# Empty = in-memory: chats are lost when the API restarts.
# Local: `docker compose up -d postgres`, then: DATABASE_URL=postgresql://rag:rag@localhost:5432/rag
# Cloud: your Neon connection string (direct, not "pooled"), e.g. postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""
# MAX_HISTORY_MESSAGES=10   # previous messages sent to the LLM as context

# --- Embeddings (Gemini) ---
GEMINI_API_KEY=""
# GEMINI_EMBEDDING_MODEL="models/gemini-embedding-2-preview"

# --- Observability (all optional) ---
LOGFIRE_TOKEN=""
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT=""

# --- UI ---
BACKEND_URL="http://localhost:8000"
